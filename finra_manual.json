{
    "manual_version": "1.0",
    "utcp_version": "1.0",
    "tools": [
        {
            "name": "search_individual",
            "description": "Search for financial brokers and investment professionals by CRD number OR name query.",
            "inputs": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "The individual's CRD number or name query (e.g., '4455114')."
                    },
                    "includePrevious": {
                        "type": "boolean",
                        "description": "Whether to include previous employment/history records.",
                        "default": true
                    },
                    "nrows": {
                        "type": "integer",
                        "description": "Number of records to return.",
                        "default": 5
                    }
                },
                "required": [
                    "query"
                ]
            },
            "tool_call_template": {
                "call_template_type": "http",
                "url": "https://api.brokercheck.finra.org/search/individual",
                "http_method": "GET"
            }
        }
    ]
}